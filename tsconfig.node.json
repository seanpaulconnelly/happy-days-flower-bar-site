{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    // `vite/client` alongside `node` because vite.config.ts imports the same
    // src/ modules the app does (src/seo/*, src/lib/images.ts) so the head can
    // be built at build time; one of them reads `import.meta.env.BASE_URL`.
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    /* Bundler mode - Vite bundles this config with esbuild, and it pulls in
       src/ files that are written for the app project's resolution. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
