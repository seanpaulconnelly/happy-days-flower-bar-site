{
  "name": "happy-days-flower-bar-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "images": "node scripts/build-images.mjs",
    "check": "node scripts/check.mjs",
    "check:copy": "node scripts/check-copy.mjs --skip-until-phase-5",
    "check:seo": "node scripts/check-seo.mjs",
    "check:config": "node scripts/check-config.mjs",
    "qa": "npm run qa:screens && npm run qa:a11y && npm run qa:lighthouse",
    "qa:screens": "node scripts/screenshots.mjs",
    "qa:form": "node scripts/form-states.mjs",
    "qa:a11y": "node scripts/a11y.mjs",
    "qa:lighthouse": "bash scripts/lighthouse.sh"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
